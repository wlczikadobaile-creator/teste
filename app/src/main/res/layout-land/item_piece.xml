<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="#FFFFFFFF"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/pieceCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/industrial_blue_dark" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/pieceDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:maxLines="2" android:textSize="16sp" />
        <TextView android:id="@+id/pieceStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="13sp" />
    </LinearLayout>
    <Button android:id="@+id/piecePdfButton" android:layout_width="100dp" android:layout_height="56dp" android:layout_marginStart="10dp" android:text="PDF" />
    <Button android:id="@+id/editPieceButton" android:layout_width="105dp" android:layout_height="56dp" android:layout_marginStart="6dp" android:text="EDITAR" />
    <Button android:id="@+id/deletePieceButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="105dp" android:layout_height="56dp" android:layout_marginStart="6dp" android:text="EXCLUIR" />
</LinearLayout>
