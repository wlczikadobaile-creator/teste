<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_light"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PEÇAS CADASTRADAS" android:textColor="@color/industrial_blue_dark" android:textSize="25sp" android:textStyle="bold" />
    <Button android:id="@+id/addPieceButton" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="14dp" android:text="+ NOVA PEÇA" android:textSize="18sp" />
    <Button android:id="@+id/generateAllPlaquesButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="8dp" android:text="GERAR TODAS EM PDF A4" android:textSize="16sp" />
    <TextView android:id="@+id/emptyPieces" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="Nenhuma peça cadastrada" android:textSize="17sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/piecesList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="10dp" android:layout_weight="1" />
    <Button android:id="@+id/backButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="58dp" android:text="VOLTAR" />
</LinearLayout>
