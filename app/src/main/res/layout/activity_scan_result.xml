<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/resultRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/industrial_blue"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="36dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/resultTitle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:gravity="center"
        android:maxLines="2"
        android:text="PEÇA LIBERADA ✔"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="56sp"
        app:autoSizeMinTextSize="26sp"
        app:autoSizeStepGranularity="2sp"
        app:autoSizeTextType="uniform" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/resultDetails"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="4"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:maxLines="9"
        android:textColor="@color/white"
        app:autoSizeMaxTextSize="34sp"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="TOQUE NA TELA PARA VOLTAR"
        android:textColor="#E6FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
