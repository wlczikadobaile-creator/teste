<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="#FFFFFFFF"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:id="@+id/reviewerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/industrial_blue_dark" android:textSize="19sp" android:textStyle="bold" />
    <TextView android:id="@+id/reviewerId" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp" />
    <TextView android:id="@+id/reviewerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <Button android:id="@+id/showQrButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="VER QR" />
        <Space android:layout_width="6dp" android:layout_height="1dp" />
        <Button android:id="@+id/editReviewerButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="EDITAR" />
        <Space android:layout_width="6dp" android:layout_height="1dp" />
        <Button android:id="@+id/deleteReviewerButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="EXCLUIR" />
    </LinearLayout>
</LinearLayout>
